# MongoDB Data API Configuration (fetch-based, no punycode errors)
# Get these from: MongoDB Atlas → App Services → HTTP Endpoints → Data API

# 1. Data API Base URL
#    From Atlas: Data API → Copy Your Endpoint URL
#    Example: https://data.mongodb-api.com/app/YOUR_APP_ID/endpoint/data/v1
MONGODB_API_URL="https://data.mongodb-api.com/app/YOUR_APP_ID/endpoint/data/v1"

# 2. Data API Key (keep secret!)
#    From Atlas: Data API → Create API Key
#    Select: "Server (with ability to read and write to any database)"
MONGODB_API_KEY="YOUR_DATA_API_KEY_HERE"

# 3. Database name (using MongoDB Sample Dataset)
MONGODB_DATABASE="sample_mflix"