# Google OAuth Configuration (for Cloudflare Worker - development)
# These need to be set in wrangler secrets for production
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here

# Note: Environment variables for the Worker are managed through:
# 1. Development: Create a .env.local.wrangler file for local testing
# 2. Production: Use `wrangler secret put GOOGLE_CLIENT_ID` to set secrets
#
# See https://developers.cloudflare.com/workers/configuration/environment-variables/ for details
