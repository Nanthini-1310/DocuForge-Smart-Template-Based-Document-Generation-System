# Cloudflare Worker Environment Variables - Development
# 
# Copy this file to .env.local.wrangler and fill in your Google OAuth credentials
# DO NOT commit .env.local.wrangler to git

# Google OAuth 2.0 Credentials (from Google Cloud Console)
# Get these from: https://console.cloud.google.com/
GOOGLE_CLIENT_ID=YOUR_GOOGLE_OAUTH_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_OAUTH_CLIENT_SECRET

# Note: The D1 (database) and R2 (storage) bindings are configured
# in wrangler.json and available automatically via c.env.DB and c.env.R2_BUCKET
